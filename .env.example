AGENT_FRAMEWORK=langgraph
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_NAME=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_DIR=models/mindbridge-qwen2.5-7b-ft
FINETUNED_MODEL_FILE=mindbridge-qwen2.5-7b-ft-q4_k_m.gguf
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=mysql+pymysql://mindbridge:mindbridge@127.0.0.1:3306/mindbridge?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_MEMORY_MAX_MESSAGES=40
REDIS_SOCKET_TIMEOUT_SECONDS=2
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
KNOWLEDGE_TOP_K=4
KNOWLEDGE_CANDIDATE_K=16
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=true
# Cross-encoder 重排（可选，默认关闭；开启需安装 sentence-transformers 并下载模型）
KNOWLEDGE_RERANK_CROSS_ENCODER_ENABLED=false
KNOWLEDGE_RERANK_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
# DashScope 语义重排（可选，默认关闭；用 qwen3-vl-rerank API，需 DASHSCOPE_API_KEY）
KNOWLEDGE_RERANK_DASHSCOPE_ENABLED=false
KNOWLEDGE_RERANK_DASHSCOPE_MODEL=qwen3-vl-rerank
KNOWLEDGE_RERANK_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
KNOWLEDGE_RERANK_DASHSCOPE_API_KEY=
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=mindbridge_knowledge_v2
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
CHROMA_SNAPSHOT_KEEP=5
EMBEDDING_TIMEOUT_SECONDS=30
RAG_EVAL_ENABLED=false
RAG_EVAL_EXIT_AFTER_RUN=false
TOOL_QUEUE_ENABLED=true
TOOL_QUEUE_POLL_INTERVAL_SECONDS=1
TOOL_QUEUE_BATCH_SIZE=10
TOOL_QUEUE_MAX_ATTEMPTS=3
TOOL_QUEUE_RETRY_DELAY_SECONDS=15
TOOL_QUEUE_EXCEL_WORKERS=1
TOOL_QUEUE_EMAIL_WORKERS=2
ALERT_EMAIL_RATE_LIMIT_PER_MINUTE=30
ALERT_EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SUBJECT_PREFIX=[MindBridge 高风险预警]

# 多域 feature flags（P0：默认全关闭，保证现有行为不变）
MULTI_DOMAIN_ENABLED=false
DOMAIN_ROUTING_SHADOW_ENABLED=false
SERVICE_DOMAIN_ENABLED=false
COMPLIANCE_DOMAIN_ENABLED=false
DOMAIN_RBAC_ENFORCED=false
LEGACY_KNOWLEDGE_DEFAULT_MENTAL_ENABLED=true

# Agent 模型配置（P4-04：compliance 模型）
AGENT_MODEL_COMPLIANCE_PROVIDER=
AGENT_MODEL_COMPLIANCE_MODEL=

# RAG 评测与可观测 feature flags（P0：默认全关闭，保证现有行为不变）
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_INPUT=false
LANGFUSE_CAPTURE_OUTPUT=false
# P5-03：Langfuse 接入配置（仅在 LANGFUSE_ENABLED=true 时生效；缺失 SDK/key 时 fail-open 回退 no-op）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TIMEOUT_SECONDS=3.0
LANGFUSE_FLUSH_ON_END=true
RAG_EVAL_LLM_ENABLED=false
RAG_EVAL_ONLINE_ENABLED=false
RAG_EVAL_ONLINE_SAMPLE_RATE=0.05
RAG_EVAL_GATE_MODE=observe

# RAG 评测 judge（P3）：建议用能力更强的模型保证评测可信；留空时回退生产 OPENAI_* 配置
RAG_EVAL_JUDGE_MODEL=qwen-max
RAG_EVAL_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EVAL_JUDGE_API_KEY=
